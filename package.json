{
  "name": "focusread-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "verify:live": "tsx --env-file=.env scripts/verify-live.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.12",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "linkedom": "^0.18.13",
    "openai": "^7.25.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
