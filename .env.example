# FocusRead API — copia a .env (ignorado por git). Nunca subas valores reales.
NODE_ENV=development
PORT=8787
APP_VERSION=1.0.0
LOG_LEVEL=info

# memory (hasta H2) | live
DATA_MODE=memory
# Solo se respeta con NODE_ENV=development. En production el servidor no arranca si es true.
DEV_AUTH_BYPASS=false

# Supabase (obligatorias si DATA_MODE=live)
SUPABASE_URL=
# SECRETA: salta el RLS, solo en el servidor
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales; se derivan de SUPABASE_URL
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# IA: proveedor real detrás de "focusread" (deepseek | openai | gemini | openrouter | groq)
DEFAULT_AI_PROVIDER=deepseek
# ID vigente verificado en la documentación del proveedor
DEFAULT_AI_MODEL=
# SECRETAS (con tope de gasto en el panel del proveedor). Solo la del proveedor por defecto es obligatoria.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Límites
FREE_DAILY_QUOTA=10
RATE_LIMIT_PER_MINUTE=10
MIN_TEXT_CHARS=300
MAX_TEXT_CHARS=50000
WORDS_PER_MINUTE=180
AI_TIMEOUT_MS=60000
URL_FETCH_TIMEOUT_MS=10000
URL_MAX_BYTES=2000000
REQUEST_BODY_LIMIT_BYTES=262144
